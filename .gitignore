# ---------------------------------------------------------------------------
# OS-specific junk
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.\#*
\#*\#
.project
.settings/

# ---------------------------------------------------------------------------
# Julia
# ---------------------------------------------------------------------------
# Code-coverage output (julia --code-coverage)
*.jl.cov
*.jl.*.cov

# Allocation tracking output (julia --track-allocation)
*.jl.mem

# Host-specific paths written by BinaryProvider / BinDeps
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Documenter.jl build output
docs/build/
docs/site/

# Julia depot / precompile artifacts checked into a project directory
/.julia/
*.cov

# NOTE: Manifest.toml is intentionally NOT ignored.
# This repository is an application (a course environment), not a library, so
# the exact resolved dependency set must be committed for reproducibility.
# See AUDIT_REPORT.md, finding MAJ-1.

# ---------------------------------------------------------------------------
# Jupyter / notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---------------------------------------------------------------------------
# Python (tooling: markdownlint wrappers, nbconvert, link checkers)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/

# ---------------------------------------------------------------------------
# Node (markdownlint-cli, lychee/markdown-link-check, etc.)
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# ---------------------------------------------------------------------------
# Build / distribution output
# ---------------------------------------------------------------------------
dist/
build/
out/
site/
_site/

# ---------------------------------------------------------------------------
# Temporary files, logs, archives
# ---------------------------------------------------------------------------
*.tmp
*.temp
*.log
*.bak
*.orig
*.rej
*.pid
*.seed

# ---------------------------------------------------------------------------
# Secrets / local environment overrides
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
